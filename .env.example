# Required
ANTHROPIC_API_KEY=sk-ant-...
ODDS_API_KEY=...          # theoddsapi.com -- free tier 500 req/month; the season cron plan needs the 20K tier
BALLDONTLIE_API_KEY=...   # balldontlie.io -- free tier, 5 req/min, sign up at app.balldontlie.io
DATABASE_URL=postgresql+psycopg://fairline:fairline@localhost:5432/fairline

# Optional
LANGCHAIN_API_KEY=lsv2_pt_...  # LangSmith tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=fairline
STRIPE_WEBHOOK_SECRET=whsec_...  # the only Stripe value read; verifies the webhook signature

# Application
CLAUDE_MODEL=claude-sonnet-4-6
FAIRLINE_ENV=               # set to "production" to refuse boot without DATABASE_URL
FAIRLINE_SIM_WEIGHT=0.25    # sim share of the blend; raise only on sim-report evidence
FAIRLINE_WEBHOOK_URL=       # Slack/Discord-compatible URL for steam alerts from `fairline watch`
FAIRLINE_DEMO_DATA=false    # keeps the sample-data banner up after the seeded rows are gone
FAIRLINE_MONTHLY_BUDGET_USD=10.00  # Claude spend ceiling per month, per process
FAIRLINE_CALL_CEILING_USD=0.40     # refuses a single call costing more than this
